// Windows resources: the interface, the icon and the version block all live
// inside the executable. Paths are relative to the repository root.
//
//   windres page.rc -O coff -o build/page_res.o
//   g++ ... viewer.cpp build/page_res.o -o build/fbsv.exe

#include <windows.h>

PAGE_HTML RCDATA "web/page.html"
APP_CSS   RCDATA "web/app.css"
TF_JS     RCDATA "web/tf.js"
APP_JS    RCDATA "web/app.js"
ROBOTO_REGULAR RCDATA "web/fonts/Roboto-Regular.woff2"
ROBOTO_BOLD    RCDATA "web/fonts/Roboto-Bold.woff2"
ROBOTO_MEDIUM      RCDATA "web/fonts/Roboto-Medium.woff2"
ROBOTO_MEDIUM_ITALIC RCDATA "web/fonts/Roboto-MediumItalic.woff2"
ROBOTO_ITALIC      RCDATA "web/fonts/Roboto-Italic.woff2"
ROBOTO_BOLD_ITALIC RCDATA "web/fonts/Roboto-BoldItalic.woff2"
1 ICON "assets/icon.ico"
APP_ICON RCDATA "assets/icon.ico"
APP_ICON_PNG RCDATA "assets/icon.png"
BRAND_PNG RCDATA "assets/brand.png"

// the skins the app falls back to when a file or an image is missing
DEFAULT_BLACK RCDATA "assets/default-black.fbskin"
DEFAULT_WHITE RCDATA "assets/default-white.fbskin"
1 RT_MANIFEST "app.manifest"

#include "build/version.rc.inc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     FBSV_VER_MAJOR,FBSV_VER_MINOR,FBSV_VER_PATCH,0
PRODUCTVERSION  FBSV_VER_MAJOR,FBSV_VER_MINOR,FBSV_VER_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Jiayu"
            VALUE "FileDescription",  "fb2km mobile skin viewer"
            VALUE "FileVersion",      "0.2.0.0"
            VALUE "InternalName",     "fbsv"
            VALUE "OriginalFilename", "fbsv.exe"
            VALUE "ProductName",      "Eclipse skin viewer"
            VALUE "ProductVersion",   "0.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
